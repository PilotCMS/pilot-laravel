{
    "name": "pilot/laravel",
    "description": "Laravel frontend adapter for reading and rendering Pilot CMS content.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0",
        "illuminate/database": "^11.0|^12.0",
        "illuminate/routing": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "illuminate/view": "^11.0|^12.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Pilot\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pilot\\Laravel\\PilotServiceProvider"
            ],
            "aliases": {
                "Pilot": "Pilot\\Laravel\\Facades\\Pilot"
            }
        }
    }
}
