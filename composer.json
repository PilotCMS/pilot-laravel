{
    "name": "pilot/laravel",
    "description": "Laravel frontend adapter for reading and rendering Pilot CMS content.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.0.2",
        "illuminate/contracts": "^9.2|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^9.2|^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^9.2|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^9.2|^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^9.2|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.6|^10.0|^11.5|^12.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "Pilot\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pilot\\Laravel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pilot\\Laravel\\PilotServiceProvider"
            ],
            "aliases": {
                "Pilot": "Pilot\\Laravel\\Facades\\Pilot"
            }
        }
    }
}
